{
  "name": "morrowlilt-self-hosted",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm run build && vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "scan:public": "node scripts/scan-public-export.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "db:migrate:local": "wrangler d1 migrations apply morrowlilt-local --local",
    "dictionary:build-wordnet": "node scripts/build-wordnet-sql.mjs",
    "dictionary:build-exams": "node scripts/build-exam-dictionary-sql.mjs",
    "cron:test:local": "curl http://localhost:5173/cdn-cgi/handler/scheduled?format=json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run cf-typegen:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run license:check && pnpm run scan:public",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check"
  },
  "dependencies": {
    "jose": "^6.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
