{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "<PLACEHOLDER>",
  "main": "worker/index.ts",
  "compatibility_date": "<PLACEHOLDER>",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_TIME_ZONE": "<PLACEHOLDER>",
    "PUBLIC_SITE_URL": "<PLACEHOLDER>",
    "MAIL_SEND_HOUR_LOCAL": "23",
    "AI_CONTENT_ENABLED": "false",
  },
  "secrets": {
    "required": [
      "ADMIN_API_KEY",
      "RESEND_API_KEY",
      "USER_SECRET_ENCRYPTION_KEY",
      "RECIPIENT_EMAIL",
      "MAIL_FROM",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<PLACEHOLDER>",
      "database_id": "<PLACEHOLDER>",
      "preview_database_id": "<PLACEHOLDER>",
      "migrations_dir": "./migrations",
    },
  ],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
